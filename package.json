{
  "name": "cosmos-drift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/server.mjs start",
    "stop": "node scripts/server.mjs stop",
    "restart": "node scripts/server.mjs restart",
    "server:status": "node scripts/server.mjs status",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:build": "node scripts/build-data.mjs",
    "data:refresh": "node scripts/build-data.mjs --refresh",
    "data:validate": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --noUnusedLocals",
    "check": "npm run typecheck && npm test && npm run data:validate && npm run build",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
